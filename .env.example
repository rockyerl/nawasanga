# ---------------------------------------------------------------------------
# Nawasanga Environment Variables Template (.env.example)
# Copy this file to .env or .env.local and configure your environment
# ---------------------------------------------------------------------------

# Database Configuration (Turso Cloud LibSQL or local file:local.db)
DATABASE_URL=libsql://your-database-name.turso.io
TURSO_AUTH_TOKEN=your-turso-jwt-auth-token

# Authentication & Session Security (JOSE JWT - min 32 chars secret)
SESSION_SECRET=your-random-32-chars-secret-key-goes-here

# Application Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
