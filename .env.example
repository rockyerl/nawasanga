# ---------------------------------------------------------------------------
# Nawasanga Environment Variables Template (.env.example)
# Production Deployment for Vercel & Turso Cloud
# ---------------------------------------------------------------------------

# 1. Database Configuration (Turso Cloud LibSQL)
# Get these from Turso CLI: `turso db show <db-name>` and `turso db tokens create <db-name>`
DATABASE_URL=libsql://your-database-name.turso.io
TURSO_AUTH_TOKEN=your-turso-jwt-auth-token
# Alternatively you can also name it TURSO_DATABASE_URL:
# TURSO_DATABASE_URL=libsql://your-database-name.turso.io

# 2. Authentication & Session Security (JOSE JWT - minimum 32 characters secret key)
# Generate a strong random key: `openssl rand -base64 32`
SESSION_SECRET=sundawa-nawasanga-production-jwt-key-32chars-min-security

# 3. Application Base URL
# Local: http://localhost:3000 | Production: https://your-project.vercel.app
NEXT_PUBLIC_APP_URL=https://your-project.vercel.app
